rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // FUNCIONES HELPER - OPTIMIZADAS
    // ========================================

    // Verifica si el usuario esta autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario es el dueno del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Obtiene el email del usuario autenticado
    function getUserEmail() {
      return request.auth.token.email;
    }

    // Lista de administradores absolutos (hardcodeada para maximo rendimiento)
    // ESTOS EMAILS TIENEN ACCESO TOTAL A TODO
    function isAbsoluteAdmin() {
      return isAuthenticated() && getUserEmail() in [
        'emilioah02@gmail.com',
        'diegopeniche.galindo25@gmail.com'
      ];
    }

    // Obtiene los datos del usuario actual (con cache implicito de Firestore)
    // IMPORTANTE: Solo llamar cuando sea estrictamente necesario
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica si el usuario tiene permisos de entrenador/admin
    // OPTIMIZADO: Solo hace una lectura si no es admin absoluto
    function hasTrainerPermissions() {
      return isAuthenticated() && (
        isAbsoluteAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().rol in ['entrenador', 'admin'])
      );
    }

    // ========================================
    // USERS COLLECTION
    // ========================================

    match /users/{userId} {
      // LECTURA: Usuario lee su perfil, o admins/entrenadores leen todos
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      // CREACION: Usuario crea su propio perfil como cliente
      // Admins absolutos pueden crear cualquier usuario
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.rol == 'cliente') ||
        (isOwner(userId) && isAbsoluteAdmin()) ||
        isAbsoluteAdmin()
      );

      // ACTUALIZACION: Usuario actualiza su perfil (sin cambiar rol)
      // Entrenadores actualizan clientes, admins absolutos actualizan todo
      allow update: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.rol == resource.data.rol) ||
        (hasTrainerPermissions() && resource.data.rol == 'cliente') ||
        isAbsoluteAdmin()
      );

      // ELIMINACION: Solo admins absolutos
      allow delete: if isAbsoluteAdmin();
    }

    // ========================================
    // ROUTINES COLLECTION - PUBLICO LECTURA
    // ========================================

    match /routines/{routineId} {
      // LECTURA: Cualquier usuario autenticado puede ver rutinas
      allow read: if isAuthenticated();

      // ESCRITURA: Solo entrenadores/admins
      allow create, update, delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // MACHINES COLLECTION - PUBLICO LECTURA
    // ========================================

    match /machines/{machineId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // EXERCISES COLLECTION - PUBLICO LECTURA
    // ========================================

    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // PRODUCTS COLLECTION - PUBLICO LECTURA
    // ========================================

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // ANNOUNCEMENTS COLLECTION - PUBLICO LECTURA
    // ========================================

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // WEEKLY ROUTINES COLLECTION
    // ========================================

    match /weekly_routines/{weeklyRoutineId} {
      // LECTURA: Cliente lee sus propias rutinas, entrenadores leen todas
      // IMPORTANTE: El query del cliente DEBE filtrar por clienteId
      allow read: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      allow create, update, delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // ASSIGNED ROUTINES COLLECTION
    // ========================================

    match /assigned_routines/{assignmentId} {
      // LECTURA: Cliente lee sus asignaciones, entrenadores leen todas
      allow read: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      // CREACION: Entrenadores/admins pueden crear cualquiera
      // Clientes pueden autoasignarse rutinas (clienteId debe ser su propio UID)
      allow create: if isAuthenticated() && (
        request.resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      // ACTUALIZACION: Entrenadores actualizan todo, clientes actualizan las suyas
      allow update: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      allow delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // HISTORY COLLECTION
    // ========================================

    match /history/{historyId} {
      // LECTURA: Cliente lee su historial, entrenadores leen todo
      allow read: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      // CREACION: Cliente crea su historial, entrenadores crean cualquiera
      allow create: if isAuthenticated() && (
        request.resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      // ACTUALIZACION: Entrenadores actualizan todo
      allow update: if isAbsoluteAdmin() || hasTrainerPermissions();

      // ELIMINACION: Cliente puede eliminar su propio historial, entrenadores eliminan cualquiera
      allow delete: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );
    }

    // ========================================
    // STORE ORDERS COLLECTION
    // ========================================

    match /store_orders/{orderId} {
      // LECTURA: Cliente lee sus pedidos, entrenadores leen todos
      allow read: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      // CREACION: Cliente crea sus pedidos, entrenadores crean cualquiera
      allow create: if isAuthenticated() && (
        request.resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      // ACTUALIZACION: Entrenadores actualizan todo
      // Clientes pueden actualizar sus pedidos (ej: marcar entregado)
      allow update: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      allow delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // ROUTINE REQUESTS COLLECTION
    // ========================================

    match /routine_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      allow update: if isAbsoluteAdmin() || hasTrainerPermissions();

      allow delete: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );
    }

    // ========================================
    // NOTIFICATIONS COLLECTION
    // ========================================

    match /notifications/{notificationId} {
      // LECTURA: Clientes leen sus notificaciones o globales, entrenadores todas
      allow read: if isAuthenticated() && (
        !('clienteId' in resource.data) ||
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      // CREACION: Cualquier usuario autenticado
      allow create: if isAuthenticated();

      // ACTUALIZACION: Clientes actualizan las suyas, entrenadores todas
      allow update: if isAuthenticated() && (
        !('clienteId' in resource.data) ||
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      allow delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // HELP NOTIFICATIONS COLLECTION
    // ========================================

    match /help_notifications/{notificationId} {
      // LECTURA: Solo entrenadores/admins
      allow read: if isAbsoluteAdmin() || hasTrainerPermissions();

      // CREACION: Cualquier usuario autenticado puede pedir ayuda
      allow create: if isAuthenticated();

      allow update, delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // CLIENT NOTIFICATION STATUS COLLECTION
    // ========================================

    match /client_notification_status/{statusId} {
      // LECTURA: Abierta para usuarios autenticados
      allow read: if isAuthenticated();

      // CREACION/ACTUALIZACION: Cliente crea/actualiza sus estados
      allow create: if isAuthenticated() && (
        request.resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      allow update: if isAuthenticated() && (
        resource.data.clienteId == request.auth.uid ||
        isAbsoluteAdmin() ||
        hasTrainerPermissions()
      );

      allow delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // TRAINERS COLLECTION (Legacy - para verificar emails de entrenadores)
    // ========================================

    match /trainers/{trainerId} {
      // LECTURA: Solo admins absolutos y entrenadores verificados
      allow read: if isAbsoluteAdmin() || hasTrainerPermissions();
      allow create, update, delete: if isAbsoluteAdmin();
    }

    // ========================================
    // PUSH NOTIFICATIONS COLLECTION
    // ========================================

    match /push_notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAbsoluteAdmin() || hasTrainerPermissions();
    }

    // ========================================
    // DEFAULT DENY - Cualquier otra coleccion
    // ========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
